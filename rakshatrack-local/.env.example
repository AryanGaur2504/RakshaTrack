# Default npm run dev / npm run build uses encrypted browser-local storage.
# For a password-protected Node/SQLite instance use npm run dev:server,
# or npm run build:server followed by npm start.
APP_PASSWORD=replace-with-a-long-random-password
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
# For remote hosting, set HOST=0.0.0.0, set a strong APP_PASSWORD (16+ characters),
# and set the externally served HTTPS origin, without a trailing slash.
# APP_ORIGIN=https://your-app.example.com

# Optional: actual Google Maps and Google Places autocomplete.
# Enable Maps JavaScript API and Places API (New) on a billing-enabled project.
# Use a browser key restricted to your localhost and hosted HTTP referrers.
# VITE_ variables are public in the browser bundle; they are not server secrets.
# VITE_GOOGLE_MAPS_API_KEY=your-restricted-browser-key
# A real Google Map ID is recommended for production; DEMO_MAP_ID is the prototype default.
# VITE_GOOGLE_MAPS_MAP_ID=your-google-map-id
